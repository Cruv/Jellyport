# Complete first-run setup with your Jellyfin server URL and administrator account.
# Subsequent sign-ins use that server's Jellyfin administrator credentials.
JELLYPORT_DATA_DIR=./data
# Set true when serving the app over HTTPS through your reverse proxy.
JELLYPORT_SECURE_COOKIE=false
# Comma-separated web hostnames for a reverse proxy or custom DNS domain (no scheme/port).
# Local names and IP literals are accepted by default. Complete first setup over LAN/localhost.
JELLYPORT_ALLOWED_HOSTS=
# Local demonstration only. No Emby/Jellyfin/Discord API calls in this mode.
JELLYPORT_DEMO=false
