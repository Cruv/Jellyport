# Fresh installations print a one-time setup code in the application logs.
# Sign in with your Jellyfin administrator account after completing setup.
# Optional for an existing installation's first upgrade only:
# JELLYPORT_ADMIN_PASSWORD=YOUR_PREVIOUS_JELLYPORT_PASSWORD
JELLYPORT_DATA_DIR=./data
# Set true when serving the app over HTTPS through your reverse proxy.
JELLYPORT_SECURE_COOKIE=false
# Local demonstration only. No Emby/Jellyfin/Discord API calls in this mode.
JELLYPORT_DEMO=false
