{
  "name": "jellyport",
  "version": "0.30.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted Emby to Jellyfin migration and Discord account management",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "docs:check": "node scripts/check-docs.mjs",
    "dev": "tsx watch server/index.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.frontend.json",
    "test": "vitest run",
    "test:e2e": "tsc --noEmit -p tsconfig.e2e.json && playwright test",
    "benchmark:snapshots": "node --import tsx scripts/benchmark-snapshots.ts",
    "format": "prettier --write server frontend e2e tests-ts scripts *.ts *.json .github/**/*.yml",
    "build": "npm run typecheck && tsc -p tsconfig.build.json && vite build",
    "start": "node dist/server/index.js",
    "benchmark:destination": "node --import tsx scripts/benchmark-destination.ts",
    "benchmark:jellyfin-import": "node --import tsx scripts/benchmark-jellyfin-import.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.5",
    "discord.js": "14.27.0",
    "dotenv": "18.0.8",
    "fastify": "5.12.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stream-json": "3.7.0",
    "unicode-case-folding": "1.1.2",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
